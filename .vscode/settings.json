{
  "cSpell.words": [
    "agentic",
    "ciphertext",
    "fedcm",
    "lucide",
    "matcha",
    "opencc",
    "openrouter",
    "pgmq",
    "pkce",
    "supabase",
    "tavily",
    "unconfigured"
  ],
  "deno.enablePaths": [
    "supabase"
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.validate": [
    "javascript",
    "typescript",
    "vue"
  ],
  "files.associations": {
    "*.css": "tailwindcss"
  }
}
